  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": false, "strictNullChecks": true, "skipLibCheck": true, "noEmit": true,
    "lib": ["ES2022", "DOM"], "baseUrl": ".", "paths": { "@/*": ["./src/*"] }
