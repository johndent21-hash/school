{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022", "jsx": "react-jsx", "module": "ESNext",
    "paths": { "@/convex/*": ["./convex/*"], "@/*": ["./src/*"] },
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "moduleResolution": "bundler", "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "strict": false, "strictNullChecks": true, "skipLibCheck": true
  }
}
